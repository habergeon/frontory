  "gsap-02": {
    "presentation": {
      "sourceHash": "ef10e3facc04a67159c9d338ae98e61fa54e9bcbe964342f22239704eb505979",
      "values": {
        "messages.display001": "<div style=\"position:sticky;top:0;background:#edf2f7;padding:12px;z-index:1\"><strong>Scroll → GSAP timeline</strong><div style=\"height:8px;background:#d4e0eb;margin:10px 0\"><div data-bar style=\"height:100%;background:#3179bf;transform-origin:left\"></div></div><output></output></div><section style=\"min-height:70%;padding:32px\"><h2>1. Input</h2><p>Scroll position is normalized by scrollHeight − clientHeight.</p></section><section style=\"min-height:70%;padding:32px\"><h2>2. Transform</h2><p>ResizeObserver recalculates the same progress after viewport changes.</p></section><section style=\"min-height:70%;padding:32px\"><h2>3. Render</h2><p>All explanations remain readable with reduced motion.</p></section>",
        "messages.display002": "reduced motion: static indicator",
        "messages.display003": "scroll-scrubbed indicator",
        "messages.display004": "% · ",
        "messages.display005": " · section ",
        "comments.comment001": "Native scroll drives a paused GSAP timeline; no ScrollTrigger plugin required."
      }
    },
    "sourceHash": "8f74d759e43a3ba6d6f8af9f5b19f77e17a46bb4ae475e75f20b470b9e71af9f",
    "values": {
      "note": "Connects basic scroll events to a GSAP timeline. It does not use the ScrollTrigger plugin."
    }
  },
  "gsap-03": {
    "presentation": {
      "sourceHash": "a530ad4d47681362910782e6a7c74b0b2284158a99982c42ad07b8105ca70420",
      "values": {
        "messages.display001": "<p>Use buttons or Left/Right arrows. Try rapid repeated input.</p><button>Previous</button> <button>Next</button> <label>Duration <input type=\"range\" min=\"0.1\" max=\"1.2\" step=\".1\" value=\".4\"></label><article style=\"margin:28px 12px;padding:28px;background:#edf2f7;border-radius:14px\"><h2></h2><p></p></article><output role=\"status\"></output>",
        "messages.display002": ". ",
        "messages.display003": "reduced motion",
        "messages.display004": "motion enabled",
        "messages.display005": "Step ",
        "messages.display006": "/4 · ",
        "messages.display007": " inputs · ",
        "comments.comment001": "Inputs remain enabled. New transitions kill old tweens and target the latest state.",
        "messages.displayFix1001": "Observe",
        "messages.displayFix1002": "Describe what changes before adjusting a variable.",
        "messages.displayFix1003": "Predict",
        "messages.displayFix1004": "Write one expected outcome and keep other conditions fixed.",
        "messages.displayFix1005": "Experiment",
        "messages.displayFix1006": "Change one variable and record the actual result.",
        "messages.displayFix1007": "Explain",
        "messages.displayFix1008": "Compare the result with the prediction."
      }
    }
  }
