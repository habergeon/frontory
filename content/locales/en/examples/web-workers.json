  "web-workers-02": {
    "presentation": {
      "sourceHash": "6523810671ca8ea8fb03556662ed7a4caa7e4ef0b1910e0b15e2f706dfcacd80",
      "values": {
        "messages.display001": "<h3>Copy, transfer, cancel</h3><label>Float32 elements <input type=\"number\" min=\"1\" max=\"4000000\" value=\"500000\"></label> <button data-mode=\"copy\">Copy</button> <button data-mode=\"transfer\">Transfer</button> <button data-mode=\"error\">Error path</button> <button data-mode=\"cancel\">Cancel</button><pre aria-live=\"polite\"></pre><p>Start another request immediately to ignore an older reply. Cancel terminates the worker and creates a fresh one on the next request. Input buffers are allocated anew.</p>",
        "messages.display002": "Canceled. Worker terminated; UI ready for a new request.",
        "messages.display003": "Worker error: ",
        "messages.display004": "Error: ",
        "messages.display005": "PASS",
        "messages.display006": "FAIL",
        "messages.display007": "sum=",
        "messages.display008": "; expected=",
        "messages.display009": "; ",
        "messages.display010": "Request ",
        "messages.display011": ", ",
        "messages.display012": "\npostMessage synchronous cost: ",
        "messages.display013": " ms\nSender byteLength before=",
        "messages.display014": ", after=",
        "messages.display015": "\nWaiting… (Copy retains sender data; transfer detaches it.)",
        "messages.display016": "Could not start worker: "
      }
    }
  },
  "web-workers-03": {
    "presentation": {
      "sourceHash": "cbb7b3270a21f2dd9f409ff7de1cd32c45bc5218e86fd8608694f53a9d30554e",
      "values": {
        "messages.display001": "<h3>Bounded worker queue</h3><label>Workers <input data-pool type=\"number\" min=\"1\" max=\"4\" value=\"2\"></label> <label>Jobs <input data-jobs type=\"number\" min=\"1\" max=\"24\" value=\"8\"></label> <button data-run=\"workers\">Worker pool</button> <button data-run=\"main\">Main thread</button> <button data-run=\"stop\">Stop</button><label>Type while running <input data-probe></label><pre aria-live=\"polite\"></pre><p>Same deterministic CPU kernel in both modes. End-to-end includes worker startup and messages. The heartbeat gap measures event-loop responsiveness, not hardware input latency.</p>",
        "messages.display002": "Stopped: no active workers or queued main-thread jobs.",
        "messages.display003": ": ",
        "messages.display004": "/",
        "messages.display005": " completed; at most ",
        "messages.display006": " in flight\nElapsed ",
        "messages.display007": " ms; heartbeat max gap ",
        "messages.display008": " ms\nResult checksum ",
        "messages.display009": "\nFinal end-to-end ",
        "messages.display010": " ms; observed heartbeat gap ",
        "messages.display011": " ms.\nAll jobs finished; pool terminated.",
        "messages.display012": "Worker failed: ",
        "messages.display013": "Choose a mode. Compare the same job count and type into the input.",
        "comments.comment001": "Keep work bounded, but substantial enough to compare UI responsiveness.",
        "messages.displayFix1001": " input events; event-loop max gap ",
        "messages.displayFix1002": " ms"
      }
    }
  }
