{
  "name": "frontory",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend learning, experiments and knowledge archive",
  "type": "module",
  "scripts": {
    "prepare:preview": "node scripts/build-preview.mjs",
    "dev": "pnpm prepare:preview && vite --host 127.0.0.1 --port 5173 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "pnpm prepare:preview && pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check:deploy": "node scripts/check-deploy.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "monaco-editor": "0.55.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
