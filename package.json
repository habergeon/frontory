{
  "name": "frontory",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend learning, experiments and knowledge archive",
  "type": "module",
  "scripts": {
    "prepare:preview": "node scripts/build-preview.mjs",
    "dev": "pnpm prepare:preview && vite --host 127.0.0.1 --port 5173 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "pnpm check:curricula && pnpm prepare:preview && pnpm typecheck && pnpm check:examples && vite build && pnpm build:search",
    "build:search": "node scripts/build-search.mjs",
    "build:curricula": "node scripts/build-curricula.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "check:curricula": "node scripts/build-curricula.mjs --check",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check:deploy": "node scripts/check-deploy.mjs",
    "check:examples": "tsc -p tsconfig.examples.json && tsc -p tsconfig.lessons.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "gsap": "3.15.0",
    "monaco-editor": "0.55.1",
    "motion": "14.5.0",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "svelte": "5.57.2",
    "three": "0.186.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
